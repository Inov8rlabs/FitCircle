{
  "name": "fitcircle",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/web && npm run dev",
    "build": "cd apps/web && npm run build",
    "start": "cd apps/web && npm run start",
    "lint": "cd apps/web && npm run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "cd apps/web && npm run type-check",
    "postinstall": "node scripts/patch-amplitude-diagnostics.cjs",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "analytics:generate": "node analytics/codegen.mjs",
    "analytics:check": "node analytics/codegen.mjs --check --only web",
    "design:generate": "node design/codegen.mjs",
    "design:check": "node design/codegen.mjs --check --only web"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "eslint": "^8.57.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.0.0",
  "dependencies": {
    "@amplitude/analytics-browser": "^2.49.0",
    "@amplitude/plugin-session-replay-browser": "^1.36.6",
    "@inov8r/engage-adapters": "file:./vendor/engage/engage-adapters-957d8692c11e30eb.tgz",
    "@inov8r/engage-protocol": "file:./vendor/engage/engage-protocol-86508b4c3c87a0b9.tgz",
    "@inov8r/engage-server": "file:./vendor/engage/engage-server-64923560e569a242.tgz",
    "@inov8r/engage-web": "file:./vendor/engage/engage-web-9ba959accf624823.tgz",
    "@inov8r/engage-connector": "file:./vendor/engage/engage-connector-8de52b94c4872c19.tgz"
  },
  "overrides": {
    "flatted": "^3.4.0",
    "postcss": "^8.5.10",
    "mdast-util-to-hast": "^13.2.1",
    "ws": "^8.20.1",
    "@inov8r/engage-protocol": "file:./vendor/engage/engage-protocol-86508b4c3c87a0b9.tgz",
    "@inov8r/engage-server": "file:./vendor/engage/engage-server-64923560e569a242.tgz",
    "@inov8r/engage-adapters": "file:./vendor/engage/engage-adapters-957d8692c11e30eb.tgz",
    "@inov8r/engage-web": "file:./vendor/engage/engage-web-9ba959accf624823.tgz",
    "sharp": "0.35.5",
    "@inov8r/engage-connector": "file:./vendor/engage/engage-connector-8de52b94c4872c19.tgz"
  }
}
