      "properties": [
        {
          "name": "method",
          "type": "enum",
          "enum": "auth_method",
          "required": true
        }
      ]
    },
    {
      "name": "Sign Up Failed",
      "category": "auth",
      "platforms": [
        "ios",
        "android",
        "web"
      ],
