          "name": "method",
          "type": "enum",
          "enum": "auth_method",
          "required": true
        }
      ]
    },
    {
      "name": "Sign Up Completed",
      "category": "auth",
      "platforms": [
        "ios",
        "android",
        "web"
      ],
