{
  "$schema": "./tracking-plan.schema.json",
  "version": 5,
  "updated": "2026-10-09",
  "conventions": {
    "eventNames": "Title Case, '<Object> <Past-tense verb>' (e.g. 'Meal Logged'). Names are frozen once shipped: rename in the analytics tool, never in code.",
    "propertyNames": "snake_case. Enum values are lowercase snake_case.",
    "identity": "user_id = FitCircle profile UUID on every platform, set on sign-up/login/session restore, cleared on logout. Never email, name or username.",
    "privacy": "Never send health VALUES (calories, macros, weight, body fat, steps, water volume, workout minutes), free text, emails, names or photos. Send coarse bands or booleans instead (has_weight, duration_band).",
    "providers": "Clients send every event to all enabled providers (Amplitude, PostHog, Sentry breadcrumbs, debug console). A provider is enabled by its key in build config.",
    "bands": "duration_band: lt_15 <15 min, 15_30 [15,30), 30_60 [30,60), 60_plus >=60."
  },
  "enums": {
    "auth_method": [
      "email",
      "apple",
      "google"
    ],
    "error_kind": [
      "network",
      "invalid_credentials",
      "account_exists",
      "validation",
      "not_found",
      "forbidden",
      "rate_limited",
      "server",
      "cancelled",
      "unknown"
    ],
    "meal_method": [
      "photo_camera",
      "photo_library",
      "voice",
      "manual",
      "search",
      "quick_add",
      "repeat"
    ],
    "meal_type": [
      "breakfast",
      "lunch",
      "dinner",
      "snack"
    ],
    "log_source": [
      "form",
      "quick_log",
      "dashboard",
      "onboarding",
      "health_sync",
      "widget",
      "check_in"
    ],
    "plan": [
      "monthly",
      "annual",
      "lifetime"
    ],
    "store": [
      "app_store",
      "play_store",
      "stripe"
    ],
    "join_source": [
      "invite_code",
      "invite_link",
      "recommendation",
      "browse"
    ],
    "duration_band": [
      "lt_15",
      "15_30",
      "30_60",
      "60_plus"
    ],
    "platform_app": [
      "ios",
      "android",
      "web"
    ],
    "environment": [
      "production",
      "development"
    ]
  },
  "globalProperties": [
    {
      "name": "platform_app",
      "type": "enum",
      "enum": "platform_app",
      "description": "Which FitCircle client sent the event. Stamped by every client."
    },
    {
      "name": "environment",
      "type": "enum",
      "enum": "environment",
      "description": "production for store/release builds, development otherwise."
    },
    {
      "name": "app_build",
      "type": "string",
      "description": "Build number (iOS CFBundleVersion, Android versionCode, web deployment id)."
    }
  ],
  "userProperties": [
    {
      "name": "plan",
      "type": "enum",
      "values": [
        "free",
        "pro"
      ],
      "description": "Current entitlement."
    },
    {
      "name": "pro_plan",
      "type": "enum",
      "values": [
        "none",
        "monthly",
        "annual",
        "lifetime"
      ],
      "description": "Which Pro product, if any."
    },
    {
      "name": "signup_method",
      "type": "enum",
      "enum": "auth_method",
      "setOnce": true,
      "description": "How the account was created."
    },
    {
      "name": "signup_platform",
      "type": "enum",
      "enum": "platform_app",
      "setOnce": true,
      "description": "Client the account was created on."
    },
    {
      "name": "account_created_date",
      "type": "string",
      "setOnce": true,
      "description": "UTC date (YYYY-MM-DD) the account was created; cohorting."
    },
    {
      "name": "onboarding_completed",
      "type": "bool",
      "description": "Has finished onboarding."
    },
    {
      "name": "units_system",
      "type": "enum",
      "values": [
        "imperial",
        "metric"
      ],
      "description": "Display units."
    },
    {
      "name": "health_connected",
      "type": "bool",
      "description": "Apple Health / Health Connect authorised."
    },
    {
      "name": "push_enabled",
      "type": "bool",
      "description": "OS push permission granted."
    },
    {
      "name": "ai_consent",
      "type": "bool",
      "description": "Allowed sending photos/voice/messages to AI providers."
    },
    {
      "name": "circles_count",
      "type": "int",
      "description": "Circles the user belongs to (updated when it changes)."
    },
    {
      "name": "primary_goal",
      "type": "string",
      "description": "Goal chosen in onboarding (e.g. lose_weight, maintain, build_muscle)."
    }
  ],
  "events": [
    {
      "name": "Sign Up Started",
      "category": "auth",
      "platforms": [
        "ios",
        "android",
        "web"
      ],
