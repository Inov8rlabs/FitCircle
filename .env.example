# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Stripe Configuration (web billing — checkout + webhook forwards receipts to RevenueCat)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_PRICE_PRO_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_PRO_ANNUAL=price_your-annual-price-id
STRIPE_COUPON_LAUNCH=coupon_id-for-first-year-launch-discount  # optional; applied to annual checkout while set
STRIPE_PRICE_PRO_LIFETIME=price_your-lifetime-price-id

# RevenueCat (subscription source of truth; webhook is the only entitlement writer)
REVENUECAT_WEBHOOK_AUTH_TOKEN=generate-a-long-random-secret-and-set-it-in-the-rc-webhook-config
REVENUECAT_SECRET_API_KEY=sk_your-revenuecat-v2-secret-api-key   # API v2 secret key (Project settings → API keys)
REVENUECAT_PROJECT_ID=proj_your-revenuecat-project-id           # from GET https://api.revenuecat.com/v2/projects
REVENUECAT_ENTITLEMENT=fitcircle_pro                              # entitlement lookup key that grants Pro (matches RC dashboard)
REVENUECAT_STRIPE_PUBLIC_API_KEY=strp_your-stripe-app-public-key  # only if Stripe web checkout forwards receipts to RC
# ALLOW_SANDBOX_WEBHOOKS=true  # never in production

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# Email Service (Resend)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=team@fitcircle.app
RESEND_REPLY_TO=support@fitcircle.app

# Push Notifications
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-api-key

# Redis (Upstash)
REDIS_URL=redis://default:password@your-redis-endpoint.upstash.io:6379
REDIS_TOKEN=your-upstash-token

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Product analytics (apps/web/app/lib/analytics, see analytics/README.md).
# Nothing loads or sends until the visitor accepts analytics cookies (fc_consent).
# Amplitude: production (NEXT_PUBLIC_VERCEL_ENV=production) defaults to the "FitCircle" project key,
# everything else (preview/local) to "FitCircle Dev". Override per environment; set to "off" to disable.
NEXT_PUBLIC_AMPLITUDE_API_KEY=            # production override (optional)
NEXT_PUBLIC_AMPLITUDE_DEV_API_KEY=        # preview/local override (optional)
NEXT_PUBLIC_AMPLITUDE_REPLAY_SAMPLE_RATE=0  # 0..1; >0 enables Session Replay (conservative masking)
# PostHog: provider is registered (and posthog-js fetched) only when the key is set.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# app_build is stamped from NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA (Vercel system env, auto-exposed).

# Sign in with Apple. Native iOS tokens use the bundle id as `aud`.
# The auth route always accepts com.inov8rlabs.apps.fitcircle. Set APPLE_CLIENT_ID
# only to allow an extra audience, such as a Services ID for web sign-in.
APPLE_BUNDLE_ID=com.inov8rlabs.apps.fitcircle

# App Configuration
NEXT_PUBLIC_APP_URL=https://fitcircle.app
NEXT_PUBLIC_API_URL=https://fitcircle.app/api
NODE_ENV=production

# JWT Configuration
JWT_SECRET=your-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# AI Features
AI_PROVIDER=openai
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key

# Storage
STORAGE_BUCKET_NAME=fitcircle-media
CDN_URL=https://cdn.fitcircle.app

# Feature Flags
ENABLE_AI_COACHING=true
ENABLE_PREMIUM_FEATURES=true
ENABLE_BETA_FEATURES=false
ADMIN_API_SECRET=generate-a-long-random-secret            # Bearer for /api/admin/* (complimentary Pro grants)

# App integrity + abuse controls (docs/INTEGRITY_CONTRACT.md, docs/SECURITY_TELEMETRY.md)
UPSTASH_REDIS_REST_URL=                     # shared rate limiter (or KV_REST_API_URL); unset = in-memory per instance
UPSTASH_REDIS_REST_TOKEN=                   # (or KV_REST_API_TOKEN)
PLAY_INTEGRITY_SA_JSON=                     # service account key JSON, raw or base64; unset = integrity checks fail open
PLAY_INTEGRITY_CERT_SHA256=                 # app signing cert SHA-256, comma list (colon hex, hex or base64url)
PLAY_INTEGRITY_PACKAGE_NAME=com.inov8rlabs.apps.fitcircle
INTEGRITY_NONCE_SECRET=generate-a-long-random-secret   # nonce HMAC key (falls back to JWT_SECRET)
AUTH_SIGNUP_CONFIRM_EMAIL=false             # true only if Supabase Auth "Confirm email" is on
SECURITY_ALERT_RECIPIENTS=                  # comma list; default ADS_REPORT_RECIPIENTS

# Free-trial sync (docs/TRIAL_SYNC.md): Admin Tools → Remote config → Free trial
# App Store: ASC_KEY_ID / ASC_ISSUER_ID / ASC_PRIVATE_KEY / ASC_APP_ID (shared with campaigns + releases; App Manager role)
GOOGLE_PLAY_SA_KEY=                         # read-only release-tracker key (JSON, raw or base64); trial sync reads with it
GOOGLE_PLAY_MONETIZATION_SA_KEY=            # writes Play offers: SA with app permission "Manage store presence" (JSON, raw or base64)
GOOGLE_PLAY_REGIONS_VERSION=2022/02         # regionsVersion.version for offer create (optional)

# Server-side GA4 subscription conversions (docs/GA4_SERVER_CONVERSIONS.md). Off unless all three are set.
GA4_SERVER_CONVERSIONS_ENABLED=false        # true = send from the RevenueCat webhook + allow ?apply=1 sweeps
GA4_MP_FIREBASE_APP_ID=                     # Android Firebase app id (1:<project number>:android:<hash>)
GA4_MP_API_SECRET=                          # GA4 Android data stream → Measurement Protocol API secret (Vercel: sensitive)
