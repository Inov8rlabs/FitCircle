# ~/FitCircleCI/config.env — runner overrides (sourced by fitcircle-ci.sh). Secrets go in secrets.env.

# Branch to watch (default main). Per-repo overrides:
# FC_BRANCH=main
# FC_IOS_BRANCH=feat/test-automation
# Clone sources (default GitHub). A local path works too, e.g. to test an unpushed branch:
# FC_IOS_URL=/Users/ani/Code/FitCircle/FitCircle-iOS-tests

# Suites per trigger (space separated; see each repo's scripts/ci/run-tests.sh)
# FC_COMMIT_SUITES_IOS="unit snapshot maestro-smoke"
# FC_COMMIT_SUITES_ANDROID="unit screenshot compose-ui maestro-smoke"
# FC_COMMIT_SUITES_BACKEND="unit"
# FC_NIGHTLY_SUITES_IOS="unit snapshot maestro-regression"
# FC_NIGHTLY_SUITES_ANDROID="unit screenshot compose-ui maestro-regression"
# FC_NIGHTLY_SUITES_BACKEND="unit smoke"

# FC_SUITE_TIMEOUT_MIN=60
# FC_KEEP_DAYS=30
# JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
# ANDROID_HOME="$HOME/Library/Android/sdk"
